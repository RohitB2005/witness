# Copy to .env and fill in. Never commit .env.

# --- LLM provider -------------------------------------------------------------
# openrouter | anthropic
WITNESS_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Model IDs for the two tiers. Verify the exact slugs on your provider's model list before use.
# Suggested: a Sonnet-class model for "smart" and a Haiku-class model for "fast".
WITNESS_MODEL_SMART=anthropic/claude-sonnet-5
WITNESS_MODEL_FAST=anthropic/claude-haiku-4.5
# Optional fallback if the smart model errors repeatedly
WITNESS_MODEL_FALLBACK=

# off | rw | replay   (replay = offline demo / reproducible eval; cache misses throw)
WITNESS_LLM_CACHE=rw

# Hard cap per run in US$ (overrides the budget preset if lower)
WITNESS_MAX_COST_USD=2.00

# --- Server -------------------------------------------------------------------
WITNESS_PORT=4317
WITNESS_RUNS_DIR=./runs
WITNESS_RETENTION_DAYS=14

# --- Bench app ----------------------------------------------------------------
# none | all | comma list e.g. B01,B05,C01
BENCH_BUGS=all
BENCH_PORT=5180
BENCH_TEST_EMAIL=demo@harbourclean.test
BENCH_TEST_PASSWORD=CleanDemo!23

# --- Exported Playwright tests ----------------------------------------------------
WITNESS_BASE_URL=http://localhost:5180
WITNESS_TEST_USER=demo@harbourclean.test
WITNESS_TEST_PASSWORD=CleanDemo!23

# --- SauceDemo (external evaluation; public practice credentials) ---------------------
SAUCEDEMO_URL=https://www.saucedemo.com
SAUCEDEMO_USER=problem_user
SAUCEDEMO_PASSWORD=secret_sauce
